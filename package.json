{
  "name": "wagering-processor",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed Wagering Processor - Jungle Gaming technical challenge",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "bun run dist/main.js",
    "start:dev": "bun --watch src/main.ts",
    "migration:run": "bun run src/scripts/run-migrations.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "bun test",
    "test:integration": "bun test ./src/**/*.integration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1120.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/typeorm": "^11.0.3",
    "@smithy/node-http-handler": "^4.11.3",
    "decimal.js": "^10.6.0",
    "joi": "^18.2.5",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "eslint": "^10.9.1",
    "@nestjs/testing": "^11.1.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "bun": "1.3.14"
  }
}
